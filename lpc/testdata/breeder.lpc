// LPC 示例脚本：繁殖行为
// 当条件满足时标记繁殖意愿，否则觅食求生

void heart_beat() {
    int x = query_x();
    int y = query_y();
    int wealth = query_attr("wealth");
    int age = query_attr("age");
    int max_age = query_attr("max_age");

    // 先觅食求生
    int best_x = x;
    int best_y = y;
    float best_sugar = 0.0;
    float s;

    s = query_cell(x, y - 1, "sugar");
    if (s > best_sugar) { best_sugar = s; best_x = x; best_y = y - 1; }
    s = query_cell(x, y + 1, "sugar");
    if (s > best_sugar) { best_sugar = s; best_x = x; best_y = y + 1; }
    s = query_cell(x - 1, y, "sugar");
    if (s > best_sugar) { best_sugar = s; best_x = x - 1; best_y = y; }
    s = query_cell(x + 1, y, "sugar");
    if (s > best_sugar) { best_sugar = s; best_x = x + 1; best_y = y; }

    if (best_sugar == 0.0) {
        int dir = random(4);
        if (dir == 0) {
            move(x, y - 1);
        } else if (dir == 1) {
            move(x, y + 1);
        } else if (dir == 2) {
            move(x - 1, y);
        } else {
            move(x + 1, y);
        }
    } else {
        move(best_x, best_y);
    }

    float got = take_cell(query_x(), query_y(), "sugar");
    set_attr("wealth", query_attr("wealth") + to_int(got));

    // 繁殖意愿：适龄且富裕（意愿的语义由世界脚本定义）
    if (age > 10) {
        if (age < max_age - 10) {
            if (wealth > 30) {
                set_attr("mate_willingness", 1);
            }
        }
    }
}
